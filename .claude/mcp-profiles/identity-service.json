{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Identity Service Development profile (~20k tokens)",
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-filesystem", "C:\\Users\\ttbasil\\Desktop\\Projects\\FullStackProjects\\ClenergizeV3"]
    },
    "mongodb-identity": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-mongo-server"],
