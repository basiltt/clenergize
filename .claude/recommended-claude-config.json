{
  "// INSTRUCTIONS": "Copy this to ~/.claude.json to optimize MCP context usage",
  "// SAVINGS": "Reduces context from ~100k tokens to ~25k tokens (75% reduction)",

  "mcpServers": {
    "// CORE - Always enabled (essential functionality)": "---",

    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-filesystem", "C:\\Users\\ttbasil\\Desktop\\Projects\\FullStackProjects"]
    },

    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-memory"]
    },

    "fetch": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-fetch"]
    },

    "// DATABASE - Enable ONE at a time based on current work": "---",

    "mongodb-general": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-mongo-server"],
      "env": {
        "MCP_MONGODB_URI": "mongodb://admin:localdev123@localhost:27017/?authSource=admin",
        "MCP_MONGODB_READONLY": "false"
      }
    },

    "// DISABLED - Uncomment when needed": "---"
  },

  "// REMOVED_SERVERS": {
    "// mssql-mcp": "REMOVED - Q2O project, not Clenergize",
    "// chrome-devtools": "DISABLED - Enable for browser debugging",
    "// mcp-axe": "DISABLED - Enable for accessibility testing",
    "// mui-mcp": "DISABLED - Enable for MUI component help",
    "// mongodb-identity": "CONSOLIDATED into mongodb-general",
    "// mongodb-organization": "CONSOLIDATED into mongodb-general",
    "// mongodb-reference": "CONSOLIDATED into mongodb-general",
    "// mongodb-activity": "CONSOLIDATED into mongodb-general",
    "// mongodb-calculation": "CONSOLIDATED into mongodb-general",
    "// mongodb-reporting": "CONSOLIDATED into mongodb-general",
    "// mongodb-audit": "CONSOLIDATED into mongodb-general",
    "// docker": "DISABLED - Enable for container work",
    "// localstack": "DISABLED - Enable for AWS simulation",
    "// playwright": "DISABLED - Enable for E2E testing",
    "// atlassian": "DISABLED - Enable for Jira/Confluence",
    "// sequential-thinking": "DISABLED - Enable for complex reasoning",
    "// time": "DISABLED - Rarely needed"
  },

  "// HOW_TO_ENABLE": {
    "step1": "Use /mcp command to toggle servers during session",
    "step2": "Or @-mention a server name to enable it",
    "step3": "Or use --mcp-config flag with profile files"
  }
}
