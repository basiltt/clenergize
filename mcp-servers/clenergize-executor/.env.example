# Clenergize MCP Executor - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# PROJECT CONFIGURATION
# ============================================================================

# Absolute path to your Clenergize V3 project root
# Windows example: C:\Users\YourName\Desktop\Projects\ClenergizeV3
# Linux/Mac example: /home/yourname/projects/ClenergizeV3
PROJECT_ROOT=C:\Users\ttbasil\Desktop\Projects\FullStackProjects\ClenergizeV3

# Environment (development, staging, production)
NODE_ENV=development

# ============================================================================
# MONGODB CONFIGURATION
# ============================================================================

# MongoDB connection string
# Local development (with Docker):
MONGODB_URI=mongodb://admin:localdev123@localhost:27017/?authSource=admin

# Production (DocumentDB):
# MONGODB_URI=mongodb://username:password@cluster-endpoint:27017/?tls=true&tlsCAFile=rds-combined-ca-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# ============================================================================
# JIRA INTEGRATION (Optional)
# ============================================================================

# Jira credentials (only needed if you want Jira integration)
# Leave empty to disable Jira operations
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_BASE_URL=https://yourcompany.atlassian.net

# Get your API token from: https://id.atlassian.com/manage-profile/security/api-tokens

# ============================================================================
# EXECUTION LIMITS
# ============================================================================

# Maximum execution timeout in milliseconds (default: 30000 = 30 seconds)
EXEC_TIMEOUT_MS=30000

# Maximum query/command length in characters (default: 5000)
MAX_QUERY_LENGTH=5000

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Enable debug logging (development only)
# DEBUG=true

# Correlation ID prefix (for distributed tracing)
# CORRELATION_ID_PREFIX=clenergize-mcp
