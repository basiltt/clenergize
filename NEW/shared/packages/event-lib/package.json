{
  "name": "@clenergize/event-lib",
  "version": "1.0.0",
  "description": "Event schemas and event bus abstraction for Clenergize V3 microservices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "clenergize",
    "events",
    "event-driven",
    "microservices",
    "domain-events"
  ],
  "author": "Clenergize Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@clenergize/common": "file:../common",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-eventbridge": "^3.933.0",
    "ioredis": "^5.8.2"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-eventbridge": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  }
}
