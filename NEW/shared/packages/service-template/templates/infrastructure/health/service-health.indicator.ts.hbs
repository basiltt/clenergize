import { Injectable } from '@nestjs/common';
import {
  HealthIndicator,
  HealthIndicatorResult,
  HealthCheckError,
} from '@nestjs/terminus';
import { HttpService } from '@nestjs/axios';
import { firstValueFrom } from 'rxjs';

/**
 * Health indicator for external service dependencies
 */
@Injectable()
export class ServiceHealthIndicator extends HealthIndicator {
  private readonly serviceUrls: Record<string, string> = {
    'identity-service': process.env.IDENTITY_SERVICE_URL || 'http://identity-service:3001',
    'organization-service': process.env.ORGANIZATION_SERVICE_URL || 'http://organization-service:3002',
    'reference-service': process.env.REFERENCE_SERVICE_URL || 'http://reference-service:3003',
    'event-bus': process.env.EVENT_BUS_URL || 'http://localhost:6379',
  };

  constructor(private readonly httpService: HttpService) {
    super();
  }

  /**
   * Check external service health
   */
  async isHealthy(serviceName: string): Promise<HealthIndicatorResult> {
    const url = this.serviceUrls[serviceName];

    if (!url) {
      return this.getStatus(serviceName, true, {
        status: 'not-configured',
        message: `Service ${serviceName} is not configured`,
      });
    }

    try {
      const start = Date.now();
      const healthUrl = `${url}/v1/health`;

      const response = await firstValueFrom(
        this.httpService.get(healthUrl, {
          timeout: 3000,
          validateStatus: (status) => status === 200,
        })
      );

      const responseTime = Date.now() - start;

      return this.getStatus(serviceName, true, {
        status: 'healthy',
        responseTime: `${responseTime}ms`,
        version: response.data.version,
        uptime: response.data.uptime,
      });
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Unknown error';
      const isTimeout = errorMessage.includes('timeout');
      const isConnectionRefused = errorMessage.includes('ECONNREFUSED');

      // Don't fail health check for optional dependencies
      const isOptional = this.isOptionalDependency(serviceName);

      if (isOptional) {
        return this.getStatus(serviceName, true, {
          status: 'degraded',
          error: errorMessage,
          optional: true,
        });
      }

      throw new HealthCheckError(
        `Service ${serviceName} health check failed`,
        this.getStatus(serviceName, false, {
          status: isTimeout ? 'timeout' : isConnectionRefused ? 'unreachable' : 'unhealthy',
          error: errorMessage,
        })
      );
    }
  }

  /**
   * Check if service is optional
   */
  private isOptionalDependency(serviceName: string): boolean {
    const optionalServices = [
      'reporting-service',
      'audit-service',
    ];

    return optionalServices.includes(serviceName);
  }
}