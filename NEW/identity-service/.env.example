# Application Configuration
NODE_ENV=development
PORT=3001
SERVICE_NAME=identity-service
VERSION=1.0.0

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# Database Configuration
MONGODB_URI=mongodb://admin:localdev123@localhost:27017/clenergize_identity?authSource=admin
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=20

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB=0
REDIS_PUBSUB_DB=1
REDIS_TTL_SECONDS=3600

# AWS Configuration (LocalStack for local development)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localhost:4566

# AWS Cognito Configuration
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1
COGNITO_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx/.well-known/jwks.json

# JWT Configuration
JWT_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
JWT_AUDIENCE=xxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800

# Event Bus Configuration
EVENT_BUS_NAME=clenergize-events
EVENT_BUS_TYPE=redis

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json

# Security Configuration
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
# Password Policy (OWASP recommendation: 12 chars minimum for adequate entropy)
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
MFA_ISSUER=Clenergize

# Session Configuration
SESSION_TTL_HOURS=8
SESSION_SLIDING_WINDOW=true
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Encryption Keys (use AWS Secrets Manager in production!)
# WARNING: DO NOT use these defaults in production!
ENCRYPTION_KEY=00000000000000000000000000000000
ENCRYPTION_IV=00000000000000000000000000000000
