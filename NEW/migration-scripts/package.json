{
  "name": "@clenergize/migration-scripts",
  "version": "1.0.0",
  "description": "Data migration scripts from OLD Clenergize V3 to NEW microservices architecture",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "migrate:all": "ts-node src/migrate-all.ts",
    "migrate:identity": "ts-node src/migrations/identity-migration.ts",
    "migrate:organization": "ts-node src/migrations/organization-migration.ts",
    "migrate:reference": "ts-node src/migrations/reference-migration.ts",
    "migrate:activity": "ts-node src/migrations/activity-migration.ts",
    "migrate:audit": "ts-node src/migrations/audit-migration.ts",
    "validate": "ts-node src/validate-migration.ts",
    "rollback": "ts-node src/rollback-migration.ts",
    "dry-run": "MIGRATION_DRY_RUN=true ts-node src/migrate-all.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "migration",
    "etl",
    "mongodb",
    "clenergize"
  ],
  "author": "Clenergize Team",
  "license": "UNLICENSED",
  "dependencies": {
    "mongodb": "^6.3.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "progress": "^2.0.3",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "async-retry": "^1.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/progress": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
